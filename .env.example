# Copy to .env and fill in (never commit the real .env).
# ───────────────────────────────────────────── Telegram ────
# Token from @BotFather (required)
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma separated Telegram user ids allowed to run /stats (optional)
ADMIN_IDS=

# ─────────────────────────────────────── Runtime mode ─────
# polling (default, recommended on Render Free) or webhook
MODE=polling
# Only needed when MODE=webhook: the public https:// URL of your service
# WEBHOOK_URL=https://vmvt-bot.onrender.com
# WEBHOOK_PATH=/webhook
# Shared secret checked in the X-Telegram-Bot-Api-Secret-Token header
# WEBHOOK_SECRET=

# ─────────────────────────────────────── HTTP server ──────
HOST=0.0.0.0
PORT=8080

# ──────────────────────────────────────── Downloading ─────
# Telegram allows bots to upload up to 50 MB
MAX_UPLOAD_MB=48
DOWNLOAD_TIMEOUT=180
CONNECT_TIMEOUT=15
MAX_LINKS_PER_MESSAGE=3

# ───────────────────────────────────────── Providers ──────
TIKWM_ENABLED=true
YTDLP_ENABLED=true
# TIKWM_API_URL=https://www.tikwm.com/api/

# ──────────────────────────────── Cache & rate limits ─────
RESOLVE_CACHE_TTL=600
MEDIA_CACHE_TTL=21600
MEDIA_CACHE_SIZE=500
RATE_LIMIT_PER_MIN=8

# ───────────────────────────────────────────── Misc ───────
LOG_LEVEL=INFO
